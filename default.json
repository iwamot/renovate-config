{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "`security:minimumReleaseAgeNpm` is ignored so that every datasource waits the same one day.",
    "One day is what the installers already enforce on their own — aube defaults to `minimumReleaseAge=1440` and mise carries the same setting — so a shorter window here would only raise pull requests that fail at install time.",
    "Raising it for npm alone would not buy protection either, since a local `aube add` still resolves at one day. Raise the installers together with this if it ever needs to be stricter."
  ],
  "extends": [
    "config:best-practices",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions",
    "workarounds:nodeDockerVersioning",
    "workarounds:typesNodeVersioning",
    ":automergeAll",
    ":gitSignOff",
    ":label(dependencies)",
    ":prConcurrentLimitNone",
    ":prHourlyLimitNone",
    ":semanticCommits"
  ],
  "ignorePresets": [
    "security:minimumReleaseAgeNpm",
    ":maintainLockFilesWeekly"
  ],
  "minimumReleaseAge": "1 day",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Disable automerge for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Restrict Node.js to LTS versions",
      "matchManagers": ["mise"],
      "matchPackageNames": ["node"],
      "versioning": "node"
    },
    {
      "description": "No minimum release age for iwamot's own packages",
      "matchSourceUrls": ["https://github.com/iwamot/**"],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track mise tasks shared via git:: includes (?ref=vX.Y.Z)",
      "managerFilePatterns": [
        "/(^|/)mise\\.toml$/"
      ],
      "matchStrings": [
        "git::https://github\\.com/(?<depName>[^/]+/[^/]+)\\.git//[^?]+\\?ref=(?<currentValue>v[\\d.]+)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Track GitHub Actions runners declared in matrix include entries",
      "managerFilePatterns": [
        "/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml$/",
        "/(^|/)action\\.ya?ml$/"
      ],
      "matchStrings": [
        "runner:\\s*(?<depName>ubuntu)-(?<currentValue>\\d{2}\\.\\d{2})(?:-arm)?\\b"
      ],
      "datasourceTemplate": "github-runners"
    },
    {
      "customType": "regex",
      "description": "Track an org/repo@ref pin annotated the customManagers:githubActionsVersions way, which that preset itself only reads off a *_VERSION key",
      "managerFilePatterns": [
        "/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml$/",
        "/(^|/)action\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s+[^\\s]+/[^\\s]+@(?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Track a version stated in Markdown, annotated the customManagers:mavenPropertyVersions way and written in a code span",
      "managerFilePatterns": [
        "/\\.md$/"
      ],
      "matchStrings": [
        "<!-- renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s+-->\\s*`(?<currentValue>[^`]+?)`"
      ]
    }
  ]
}
